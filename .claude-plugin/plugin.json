{
  "name": "ai-coop",
  "version": "0.11.0",
  "description": "Open once, then let Claude and Codex collaborate automatically in the native chat.",
  "author": {
    "name": "AI Coop contributors"
  },
  "license": "MIT",
  "keywords": [
    "multi-agent",
    "codex",
    "claude",
    "collaboration"
  ],
  "skills": "./skills/",
  "hooks": "./hooks/hooks.json",
  "mcpServers": {
    "ai-coop": {
      "command": "python",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/mcp_server.py",
        "--host-agent",
        "claude"
      ],
      "env": {
        "AI_COOP_HOST_AGENT": "claude"
      }
    }
  }
}
